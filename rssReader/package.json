{
    "name": "@camstreamer/rss-reader",
    "version": "1.0.0",
    "description": "RSS feed reader for CamOverlay App infoticker and custom graphics",
    "main": "main.js",
    "scripts": {
        "clean": "rimraf dist/* html/* *.zip",
        "build:BE": "tsc",
        "build:FE": "cd react && npm run build",
        "build": "npm-run-all build:BE build:FE",
        "start": "cd react && npm run dev",
        "try": "set PERSISTENT_DATA_PATH=./localdata/ && ts-node src/main.ts",
        "in:ui": "cd react && npm install",
        "zip:package": "node node_modules/camstreamerlib/CreatePackage -i -e=react",
        "zip": "npm-run-all clean in:ui build zip:package"
    },
    "author": "CamStreamer s.r.o",
    "license": "ISC",
    "dependencies": {
        "camstreamerlib": "^2.0.2",
        "xml-js": "^1.6.11",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/node": "^18.19.0",
        "npm-run-all": "^4.1.5",
        "rimraf": "^5.0.5",
        "ts-node": "^10.9.2",
        "typescript": "^5.3.3"
    }
}
